# =============================================================================
# FaceVital AI — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# --- Application ---
APP_NAME=FaceVital AI
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=1

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000

# --- Database ---
# For lightweight local development, use SQLite (zero setup required):
DATABASE_URL=sqlite+aiosqlite:///facevital.db

# For production / Docker, uncomment and configure PostgreSQL:
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=facevital
# POSTGRES_USER=facevital_user
# POSTGRES_PASSWORD=change_me_in_production
# DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Security ---
SECRET_KEY=change-this-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Model ---
MODEL_WEIGHTS_DIR=./models/weights
MODEL_VERSION=v1.0.0-placeholder

# --- rPPG ---
RPPG_WINDOW_SECONDS=10
RPPG_OVERLAP=0.5
RPPG_MIN_HR=40
RPPG_MAX_HR=180
SIGNAL_QUALITY_THRESHOLD=0.4

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Observability ---
ENABLE_STRUCTURED_LOGGING=true
